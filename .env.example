# 复制为 .env 后按实际情况填写

# --- 必填 ---
# JWT 签名密钥。生成:openssl rand -base64 48
SNIPE_SECRET_KEY=

# 初始管理员。首次启动时创建,登录后会被强制改密
SNIPE_INITIAL_ADMIN_USERNAME=admin
SNIPE_INITIAL_ADMIN_PASSWORD=

# --- 宝塔 / 已有 Nginx 反代时用 ---
# 容器在宿主机上监听的回环端口,宝塔的反向代理填这个
SNIPE_PORT=8000

# --- 独立服务器 + 自带 Caddy 时用(docker-compose.caddy.yml) ---
# 对外域名,Caddy 据此自动申请 HTTPS 证书
SITE_ADDRESS=assets.example.com

# --- 一般不用改 ---
# 对外走 HTTPS 时保持 true;仅在纯内网 http 调试时才设成 false
SNIPE_COOKIE_SECURE=true
